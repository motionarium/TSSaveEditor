                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                         <Path Data="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-3.5 3.5h-2.5V8.5H18v3z"
                                               Fill="{DynamicResource AccentBrush}"
                                               Width="36" Height="36" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ETS2 / ATS Save Editor" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="{DynamicResource AccentBgBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                                    <TextBlock x:Name="AboutVersionBadge" Text="v1.1.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                                <Border Background="#1C202C" CornerRadius="4" Padding="8,2">
                                                    <TextBlock Text="ETS2 1.60+ · ATS 1.60+" FontSize="11" Foreground="#5A6070"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Uid="about.desc" Foreground="#8A93A5" FontSize="12" TextWrapping="Wrap" LineHeight="20"
                                               Text="Редактор сейвов для Euro Truck Simulator 2 и American Truck Simulator. Позволяет изменять баланс, опыт, навыки, разблокировать города и управлять гаражами без ручного редактирования файлов."/>
                                </StackPanel>
                            </Border>

                            <!-- Authors -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                              Fill="{DynamicResource AccentBrush}"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Uid="about.authors" Text="Авторы" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="#0F1117" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Uid="about.lead" Text="Основной разработчик" FontSize="11" Foreground="#7A8496" Margin="0,0,0,2"/>
                                                <TextBlock Text="motionarium" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource AccentBgBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="Lead Dev" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Libraries -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Path Data="M11.99 18.54l-7.37-5.73L3 14.07l9 7 9-7-1.63-1.27zM12 16l7.36-5.73L21 9l-9-7-9 7 1.63 1.27L12 16z"
                                              Fill="{DynamicResource AccentBrush}"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Uid="about.libs" Text="Используемые библиотеки" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- .NET -->
                                    <Border Background="#0F1117" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text=".NET 8.0 + WPF" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,2"/>
                                                <TextBlock Uid="about.net" Text="Microsoft — фреймворк приложения и UI" FontSize="11" Foreground="#7A8496"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="MIT" FontSize="11" Foreground="#7A8496" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- zlib -->
                                    <Border Background="#0F1117" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="zlib 1.3" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,2"/>
                                                <TextBlock Uid="about.zlib" Text="Jean-loup Gailly &amp; Mark Adler — сжатие/распаковка сейвов" FontSize="11" Foreground="#7A8496"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="zlib" FontSize="11" Foreground="#7A8496" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- TruckLib -->
                                    <Border Background="#0F1117" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="TruckLib" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,2"/>
                                                <TextBlock Uid="about.trucklib" Text="sk-zk — чтение HashFS/ZIP .scs и карт .mbd" FontSize="11" Foreground="#7A8496"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="GPL-2.0" FontSize="11" Foreground="#7A8496" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- SII decoder concept -->
                                    <Border Background="#0F1117" CornerRadius="6" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Uid="about.sii.title" Text="SII Decrypt (концепт)" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,2"/>
                                                <TextBlock Uid="about.sii" Text="Open-source сообщество — алгоритм декодирования SII" FontSize="11" Foreground="#7A8496"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="MIT" FontSize="11" Foreground="#7A8496" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Update check -->
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Uid="about.update.title" Text="Актуальная версия" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="AboutUpdateHint"
                                                   Text="Нажмите, чтобы проверить обновления на GitHub"
                                                   FontSize="11" Foreground="#7A8496" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCheckUpdate" Grid.Column="1"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BtnCheckUpdate_Click"
                                            ToolTip="@about.update.tip">
                                        <StackPanel Orientation="Horizontal">
                                             <Path Data="M19 8l-4 4h3c0 3.31-2.69 6-6 6-1.01 0-1.97-.25-2.8-.7l-1.46 1.46C8.97 19.54 10.43 20 12 20c4.42 0 8-3.58 8-8h3l-4-4zM6 12c0-3.31 2.69-6 6-6 1.01 0 1.97.25 2.8.7l1.46-1.46C15.03 4.46 13.57 4 12 4c-4.42 0-8 3.58-8 8H1l4 4 4-4H6z"
                                                   Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                   Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="BtnCheckUpdateLabel" Text="Проверить обновление" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  APP DIALOG OVERLAY                                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="AppDialogOverlay" Grid.RowSpan="3"
                Background="#D60F1117" Visibility="Collapsed" Opacity="0"
                IsHitTestVisible="True" Panel.ZIndex="1000" Padding="24">
            <Border x:Name="AppDialogCard" Background="#1A1D27" BorderBrush="#2A303C" BorderThickness="1"
                    CornerRadius="14" Padding="28,26" MaxWidth="440" MinWidth="320"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="AppDialogScale" ScaleX="0.94" ScaleY="0.94"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Border x:Name="AppDialogIconBg" Width="48" Height="48" CornerRadius="24"
                            Background="#1B3A2A" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path x:Name="AppDialogIcon"
                              Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                              Fill="#69F0AE" Width="22" Height="22" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="AppDialogTitle" Text="Успех"
                               FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="AppDialogMessage" Text=""
                               FontSize="13" Foreground="#8A93A5" LineHeight="20"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,22"/>
                    <Button x:Name="BtnAppDialogOk" Content="OK"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="40" MinWidth="120" Padding="24,0"
                            HorizontalAlignment="Center"
                            Click="BtnAppDialogOk_Click"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  FIRST-RUN SETUP                                            -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="FirstRunOverlay" Grid.RowSpan="3"
                Background="#F00F1117" Visibility="Collapsed" Opacity="0"
                IsHitTestVisible="True" Panel.ZIndex="2000" Padding="24">
            <Border x:Name="FirstRunCard" Background="#1A1D27" BorderBrush="#2A303C" BorderThickness="1"
                    CornerRadius="16" Padding="32,30" MaxWidth="520" MinWidth="360"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="FirstRunScale" ScaleX="0.94" ScaleY="0.94"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Path Data="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-3.5 3.5h-2.5V8.5H18v3z"
                          Fill="{DynamicResource AccentBrush}"
                          Width="36" Height="36" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock x:Name="TxtFirstRunWelcome" Uid="firstrun.welcome" Text="Добро пожаловать"
                               FontSize="22" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtFirstRunSubtitle" Uid="firstrun.subtitle"
                               Text="Выберите язык и цветовую тему — это займёт пару секунд."
                               FontSize="13" Foreground="#7A8496" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,0,0,22" LineHeight="19"/>

                    <TextBlock x:Name="TxtFirstRunLangLabel" Uid="firstrun.lang" Text="Язык" FontSize="11" FontWeight="SemiBold"
                               Foreground="#5A6070" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Margin="0,0,0,20">
                        <Border x:Name="CardLangRu" Margin="0,0,6,0" Padding="14,12" CornerRadius="10"
                                Background="#0F1117" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                                Cursor="Hand" MouseLeftButtonUp="FirstRunLang_Click" Tag="ru">
                            <TextBlock x:Name="TxtCardLangRu" Text="Русский" FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="CardLangEn" Margin="6,0,0,0" Padding="14,12" CornerRadius="10"
                                Background="#0F1117" BorderBrush="#2D323E" BorderThickness="1.5"
                                Cursor="Hand" MouseLeftButtonUp="FirstRunLang_Click" Tag="en">
                            <TextBlock x:Name="TxtCardLangEn" Text="English" FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                    </UniformGrid>

                    <TextBlock x:Name="TxtFirstRunThemeLabel" Uid="firstrun.theme" Text="Тема" FontSize="11" FontWeight="SemiBold"
                               Foreground="#5A6070" Margin="0,0,0,10"/>
                    <UniformGrid Columns="6" Margin="0,0,0,26">
                        <Border Margin="0,0,6,0" Width="36" Height="36" CornerRadius="18" Background="#00E5FF"
                                Cursor="Hand" Tag="cyan" MouseLeftButtonUp="FirstRunTheme_Click"
                                BorderBrush="White" BorderThickness="2" x:Name="SwatchCyan"/>
                        <Border Margin="3,0" Width="36" Height="36" CornerRadius="18" Background="#D500F9"
                                Cursor="Hand" Tag="purple" MouseLeftButtonUp="FirstRunTheme_Click"
                                BorderBrush="Transparent" BorderThickness="2" x:Name="SwatchPurple"/>
                        <Border Margin="3,0" Width="36" Height="36" CornerRadius="18" Background="#00E676"
                                Cursor="Hand" Tag="green" MouseLeftButtonUp="FirstRunTheme_Click"
                                BorderBrush="Transparent" BorderThickness="2" x:Name="SwatchGreen"/>
                        <Border Margin="3,0" Width="36" Height="36" CornerRadius="18" Background="#2979FF"
                                Cursor="Hand" Tag="blue" MouseLeftButtonUp="FirstRunTheme_Click"
                                BorderBrush="Transparent" BorderThickness="2" x:Name="SwatchBlue"/>
                        <Border Margin="3,0" Width="36" Height="36" CornerRadius="18" Background="#FF9100"
                                Cursor="Hand" Tag="orange" MouseLeftButtonUp="FirstRunTheme_Click"
                                BorderBrush="Transparent" BorderThickness="2" x:Name="SwatchOrange"/>
                        <Border Margin="6,0,0,0" Width="36" Height="36" CornerRadius="18" Background="#FF1744"
                                Cursor="Hand" Tag="red" MouseLeftButtonUp="FirstRunTheme_Click"
                                BorderBrush="Transparent" BorderThickness="2" x:Name="SwatchRed"/>
                    </UniformGrid>

                    <Button x:Name="BtnFirstRunContinue" Uid="firstrun.continue" Content="Продолжить"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44" MinWidth="180" Padding="24,0"
                            HorizontalAlignment="Center"
                            Click="BtnFirstRunContinue_Click"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  SPLASH / LAUNCH ANIMATION                                  -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="SplashOverlay" Grid.RowSpan="3"
                Background="#0F1117" Visibility="Visible" Opacity="1"
                IsHitTestVisible="True" Panel.ZIndex="3000">
            <Grid>
                <StackPanel x:Name="SplashContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SplashScale" ScaleX="0.86" ScaleY="0.86"/>
                            <TranslateTransform x:Name="SplashTranslate" Y="12"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <Path x:Name="SplashLogo"
                          Data="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-3.5 3.5h-2.5V8.5H18v3z"
                          Fill="{DynamicResource AccentBrush}"
                          Width="52" Height="52" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="TRUCK SAVES" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtSplashTagline" Text="Save Editor" FontSize="13"
                               Foreground="#5A6070" HorizontalAlignment="Center" Margin="0,8,0,18"/>
                    <Border x:Name="SplashLine" Height="2" Width="0" CornerRadius="1"
                            Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
