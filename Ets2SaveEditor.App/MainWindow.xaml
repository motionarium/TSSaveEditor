                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="tipSlide" Y="4"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tipBorder" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="tipSlide" Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Quiet list item (no selection flash for checkbox lists) ─ -->
        <Style x:Key="QuietListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="#E8ECF4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161A24"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Selectable fleet list (trucks / trailers) ─────────────── -->
        <Style x:Key="SelectableListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="#E8ECF4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="#12151C" BorderBrush="#1C202C"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="accent" Width="3" HorizontalAlignment="Left"
                                        Margin="-10, -8, 0, -8" CornerRadius="8,0,0,8"
                                        Background="Transparent"/>
                                <ContentPresenter Margin="4,0,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161A24"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2A303C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2030"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2A3548"/>
                                <Setter TargetName="accent" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FleetItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TitleLabel}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="#E8ECF4" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding LicensePlate}" FontSize="11" Foreground="#6A7386"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LicensePlate}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LicensePlate}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding PlateTypeLabel}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlateTypeLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                        Background="{DynamicResource AccentBgBrush}" CornerRadius="4" Padding="7,3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="★" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ── TabItem: hide header strip ────────────────────────────── -->
        <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- ── TextBlock default ──────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- ── City listbox item template ────────────────────────────── -->
        <DataTemplate x:Key="CityItemTemplate">
            <CheckBox IsChecked="{Binding IsVisited}" Foreground="White" Margin="0,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#CCCCCC"/>
            </CheckBox>
        </DataTemplate>

        <!-- ── Garage listbox item template ───────────────────────────── -->
        <DataTemplate x:Key="GarageItemTemplate">
            <Border BorderBrush="#1C202C" BorderThickness="0,0,0,1" Padding="0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Имя города и текстовый статус -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CityName}" FontWeight="SemiBold" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Слайдер уровня (от 0 до 3) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider Value="{Binding Status, Mode=TwoWay}" Minimum="0" Maximum="3" 
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusLevelText}" 
                                   FontSize="10" Foreground="#555E70" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header bar -->
            <RowDefinition Height="*"/>     <!-- Main content -->
            <RowDefinition Height="Auto"/>  <!-- Global save bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  HEADER BAR — Always-visible profile/save selector         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#14171E" BorderBrush="#20242D" BorderThickness="0,0,0,1" Padding="20,11,20,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Path Data="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-3.5 3.5h-2.5V8.5H18v3z"
                          Fill="{DynamicResource AccentBrush}"
                          Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TRUCK SAVES" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="ETS2 / ATS Editor" FontSize="10" Foreground="#3A3F50"/>
                    </StackPanel>
                </StackPanel>

                <!-- Selectors -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="170"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="LblGameHeader" Uid="hdr.game" Text="ИГРА" FontSize="9" Foreground="#3A3F50" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComboGame" SelectionChanged="ComboGame_SelectionChanged"
                                  Width="84" MinWidth="84" Padding="8,6,22,6"
                                  ToolTip="@hdr.game.tip">
                            <ComboBoxItem Content="ETS 2" IsSelected="True"/>
                            <ComboBoxItem Content="ATS"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock x:Name="LblSourceHeader" Uid="hdr.source" Text="ИСТОЧНИК" FontSize="9" Foreground="#3A3F50" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComboSource" SelectionChanged="ComboSource_SelectionChanged"
                                  ToolTip="@hdr.source.tip">
                            <ComboBoxItem x:Name="ComboSourceLocal" Content="Local" Tag="local" IsSelected="True"/>
                            <ComboBoxItem x:Name="ComboSourceSteam" Content="Steam" Tag="steam"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock x:Name="LblProfileHeader" Uid="hdr.profile" Text="ПРОФИЛЬ" FontSize="9" Foreground="#3A3F50" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComboProfile" SelectionChanged="ComboProfile_SelectionChanged"
                                  ToolTip="@hdr.profile.tip"/>
                        <TextBlock x:Name="TxtSteamId" FontSize="10" Foreground="#555E70" Margin="0,4,0,0"
                                   Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                   ToolTip="@hdr.steamid.tip"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" x:Name="PanelSaveSelector">
                        <TextBlock x:Name="LblSaveHeader" Uid="hdr.save" Text="СОХРАНЕНИЕ" FontSize="9" Foreground="#3A3F50" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Border x:Name="SaveSelectorHighlight" BorderBrush="Transparent" BorderThickness="1.5"
                                CornerRadius="8" Padding="0" Margin="-3">
                            <ComboBox x:Name="ComboSave" SelectionChanged="ComboSave_SelectionChanged" Margin="3"
                                      ToolTip="@hdr.save.tip"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Refresh — aligned with combo boxes, not labels -->
                <Button Grid.Column="2" x:Name="BtnRefresh" Content="↻" FontSize="17"
                        Style="{StaticResource SecondaryButtonStyle}" Width="44" Height="36"
                        Margin="14,17,0,0" VerticalAlignment="Top"
                        Click="BtnRefresh_Click"
                        ToolTip="@hdr.refresh.tip"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  MAIN AREA                                                  -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ────────────────────────────────────────────── -->
            <Border Grid.Column="0" Background="#0F1117" BorderBrush="#1A1D27" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,16,10,16">
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="BtnOpenSettings" Style="{StaticResource SidebarLinkButtonStyle}"
                                Click="BtnOpenSettings_Click" ToolTip="@nav.settings.tip">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65C14.46 2.18 14.25 2 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.23-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.23.09.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zM12 15.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5z"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBtnSettings" Uid="nav.settings" Text="Настройки" VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnOpenAbout" Style="{StaticResource SidebarLinkButtonStyle}"
                                Click="BtnOpenAbout_Click" ToolTip="@nav.about.tip">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBtnAbout" Uid="nav.about" Text="О программе" VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel>
                        <RadioButton x:Name="NavEconomy" Style="{StaticResource NavButtonStyle}"
                                     IsChecked="True" Checked="Navigation_Checked"
                                     Tag="M21 7H3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zm-5 7a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"
                                     Uid="nav.economy" Content="Экономика" FontSize="13"
                                     ToolTip="@nav.economy.tip"/>

                        <RadioButton x:Name="NavMap" Style="{StaticResource NavButtonStyle}"
                                     Checked="Navigation_Checked"
                                     Tag="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                     Uid="nav.map" Content="Карта и Гаражи" FontSize="13"
                                     ToolTip="@nav.map.tip"/>

                        <RadioButton x:Name="NavVehicle" Style="{StaticResource NavButtonStyle}"
                                     Checked="Navigation_Checked"
                                     Tag="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-3.5 3.5h-2.5V8.5H18v3z"
                                     Uid="nav.vehicle" Content="Техника" FontSize="13"
                                     ToolTip="@nav.vehicle.tip"/>

                        <RadioButton x:Name="NavMods" Style="{StaticResource NavButtonStyle}"
                                     Checked="Navigation_Checked"
                                     Tag="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z"
                                     Uid="nav.mods" Content="Моды" FontSize="13"
                                     ToolTip="@nav.mods.tip"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── TAB CONTENT ────────────────────────────────────────── -->
            <TabControl Grid.Column="1" x:Name="MainTabControl" Background="Transparent" BorderThickness="0">

                <!-- ╔═══════════════════════════════════════╗ -->
                <!-- ║  TAB 1: ECONOMY                       ║ -->
                <!-- ╚═══════════════════════════════════════╝ -->
                <TabItem Header="Economy">
                    <Grid>
                    <ScrollViewer x:Name="ScrollEconomy" VerticalScrollBarVisibility="Auto" Background="#0F1117">
                        <StackPanel Margin="22,18,22,22">

                            <!-- Money | Level -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="16,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Style="{StaticResource SectionIconBadge}" Margin="0,0,8,0">
                                                <Path Data="M21 7H3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zm-5 7a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"
                                                      Fill="{DynamicResource AccentBrush}"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Uid="econ.money.title" Text="Баланс аккаунта" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Uid="econ.money.hint" Text="€ для ETS2 · $ для ATS"
                                                   FontSize="11" Foreground="#6A7386" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        <TextBox x:Name="TxtMoney" Height="44" FontSize="18" FontWeight="Bold"
                                                 TextChanged="SaveField_Changed"
                                                 ToolTip="@econ.money.tip"/>
                                        <WrapPanel x:Name="PanelQuickMoney" Margin="0,10,0,0">
                                            <Button Content="1M"   Tag="1000000"   Click="QuickMoney_Click" Style="{StaticResource ChipButtonStyle}"/>
                                            <Button Content="5M"   Tag="5000000"   Click="QuickMoney_Click" Style="{StaticResource ChipButtonStyle}"/>
                                            <Button Content="10M"  Tag="10000000"  Click="QuickMoney_Click" Style="{StaticResource ChipButtonStyle}"/>
                                            <Button Content="50M"  Tag="50000000"  Click="QuickMoney_Click" Style="{StaticResource ChipButtonStyle}"/>
                                            <Button Content="100M" Tag="100000000" Click="QuickMoney_Click" Style="{StaticResource ChipButtonStyle}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" Padding="16,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Style="{StaticResource SectionIconBadge}" Margin="0,0,8,0">
                                                <Path Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                                                      Fill="{DynamicResource AccentBrush}"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Uid="econ.level.title" Text="Уровень и опыт" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Uid="econ.level.hint" Text="Выберите уровень — XP подставится сам"
                                                   FontSize="11" Foreground="#6A7386" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Uid="econ.xp.title" Text="Очки опыта (XP)" FontSize="11" Foreground="#6A7386" Margin="0,0,0,6"/>
                                            <TextBlock Uid="econ.level" Grid.Column="2" Text="Уровень" FontSize="11" Foreground="#6A7386" Margin="0,0,0,6"/>

                                            <TextBox x:Name="TxtXp" Grid.Row="1" Height="40" FontSize="16" FontWeight="Bold"
                                                     ToolTip="@econ.xp.tip"
                                                     TextChanged="TxtXp_TextChanged"/>
                                            <ComboBox x:Name="ComboPlayerLevel" Grid.Row="1" Grid.Column="2"
                                                      Height="40" FontSize="13" FontWeight="SemiBold"
                                                      SelectionChanged="ComboPlayerLevel_SelectionChanged"
                                                      ToolTip="@econ.level.tip"/>
                                        </Grid>

                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Uid="econ.xp.lvl10" Content="Ур. 10" Tag="10" Click="QuickLevel_Click" Style="{StaticResource ChipButtonStyle}"/>
                                            <Button Uid="econ.xp.lvl25" Content="Ур. 25" Tag="25" Click="QuickLevel_Click" Style="{StaticResource ChipButtonStyle}"/>
                                            <Button Uid="econ.xp.lvl50" Content="Ур. 50" Tag="50" Click="QuickLevel_Click" Style="{StaticResource ChipButtonStyle}"/>
                                            <Button Uid="econ.xp.lvl100" Content="Ур. 100" Tag="100" Click="QuickLevel_Click" Style="{StaticResource ChipButtonStyle}"/>
                                            <Button Uid="econ.xp.lvl150" Content="Ур. 150" Tag="150" Click="QuickLevel_Click" Style="{StaticResource ChipButtonStyle}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ADR | Skills -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="16,14">
