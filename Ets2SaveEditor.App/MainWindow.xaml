                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Style="{StaticResource SectionIconBadge}" Margin="0,0,8,0">
                                                <Path Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                                                      Fill="{DynamicResource AccentBrush}"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Uid="econ.adr.title" Text="Лицензии ADR" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Uid="econ.adr.hint" Text="Допуск к перевозке опасных грузов по классам"
