<Window x:Class="Ets2SaveEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETS2 / ATS Save Editor — v1.60+" Height="740" Width="1100"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen" Background="#0F1117"
        Foreground="#FFFFFF" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="MainWindow_SourceInitialized">

    <Window.Resources>
        <!-- Цветовая схема: акцентный цвет (DynamicResource) -->
        <SolidColorBrush x:Key="AccentBrush" Color="#00E5FF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#00CCDF"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#009AB0"/>
        <SolidColorBrush x:Key="AccentBgBrush" Color="#1B2740"/>
        <SolidColorBrush x:Key="AccentBgPressedBrush" Color="#0D1E30"/>
        <Color x:Key="AccentColor">#00E5FF</Color>

        <!-- ── Slider track button ─────────────────────────────────────── -->
        <Style x:Key="SliderTrackBtn" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Slider thumb ────────────────────────────────────────────── -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="thumbScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="glow" Width="18" Height="18"
                                     Fill="{DynamicResource AccentBrush}" Opacity="0.25"/>
                            <Ellipse x:Name="outer" Width="16" Height="16"
                                     Fill="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="inner" Width="6" Height="6"
                                     Fill="#0F1117"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.18" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.18" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0.45" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0.25" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.28" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.28" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="Width"
                                                             To="4" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="Height"
                                                             To="4" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.18" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.18" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="Width"
                                                             To="6" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="Height"
                                                             To="6" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Slider (default: 0–6 skill range) ─────────────────────── -->
        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="6"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <!-- Soft track background -->
                            <Border Height="6" CornerRadius="3" Background="#1C202C"
                                    VerticalAlignment="Center" Margin="0,0,0,0"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackBtn}"
                                                  Background="{DynamicResource AccentBrush}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackBtn}"
                                                  Background="#2A303C"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Minimalist ScrollBar ────────────────────────────────────── -->
        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="rectangle"
                                CornerRadius="3"
                                Background="#3A3F50"
                                Opacity="0.5"
                                Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rectangle" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="rectangle" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="rectangle" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="rectangle" Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="true"
                                   IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                                    <Track x:Name="PART_Track"
                                           IsEnabled="{TemplateBinding IsEnabled}">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumb}" Margin="0,2"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Animated CheckBox ──────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="boxScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Border x:Name="border"
                                        Width="18" Height="18"
                                        CornerRadius="4"
                                        Background="#12151C"
                                        BorderBrush="#2D323E"
                                        BorderThickness="1.5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                <Border x:Name="hoverRing"
                                        Width="18" Height="18"
                                        CornerRadius="4"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1.5"
                                        Opacity="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                <Border x:Name="fill"
                                        Width="18" Height="18"
                                        CornerRadius="4"
                                        Background="{DynamicResource AccentBrush}"
                                        Opacity="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                <Path x:Name="checkMark"
                                      Width="10" Height="8"
                                      Data="M 0 3.5 L 3.5 7 L 10 0"
                                      Stroke="#0A0D12"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Opacity="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="checkScale" ScaleX="1" ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverRing" Storyboard.TargetProperty="Opacity"
                                                             To="0.7" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.08" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.08" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverRing" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fill" Property="Opacity" Value="1"/>
                                <Setter TargetName="checkMark" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="checkMark" Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.14" BeginTime="0:0:0.04"/>
                                            <DoubleAnimation Storyboard.TargetName="checkScale" Storyboard.TargetProperty="ScaleX"
                                                             From="0.45" To="1" Duration="0:0:0.2" BeginTime="0:0:0.02">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.45"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="checkScale" Storyboard.TargetProperty="ScaleY"
                                                             From="0.45" To="1" Duration="0:0:0.2" BeginTime="0:0:0.02">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.45"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.14" Duration="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.14" Duration="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.14" BeginTime="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.14" BeginTime="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="checkMark" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="checkScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.45" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="checkScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.45" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Minimalist RadioButton ────────────────────────────────── -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="border"
                                         Width="16" Height="16"
                                         Stroke="#2D323E"
                                         StrokeThickness="1"
                                         Fill="#12151C"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                                <Ellipse x:Name="dot"
                                         Width="6" Height="6"
                                         Fill="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Card ───────────────────────────────────────────────────── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1D27"/>
            <Setter Property="BorderBrush" Value="#252932"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <EventSetter Event="MouseEnter" Handler="Card_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="Card_MouseLeave"/>
        </Style>

        <!-- Icon badge used in section headers (Mods-style) -->
        <Style x:Key="SectionIconBadge" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource AccentBgBrush}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── No-save blocking overlay ───────────────────────────────── -->
        <Style x:Key="NoSaveOverlayStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF0F1117"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- ── Sidebar nav button ─────────────────────────────────────── -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SidebarNav"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8A93A5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8"
                                BorderThickness="1" BorderBrush="Transparent"
                                Padding="10,9" Margin="0,2"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="navScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="icon" Grid.Column="0"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="{TemplateBinding Foreground}"
                                      Opacity="0.85"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="label" Grid.Column="1" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161A24"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.02" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.02" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBgBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="icon" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="icon" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Sidebar utility link (Settings / About) ───────────────── -->
        <Style x:Key="SidebarLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A93A5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
