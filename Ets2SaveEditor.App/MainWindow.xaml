                                        <CheckBox x:Name="ChkAdr0" Uid="econ.adr.0" Content="Класс 1 — Взрывчатые" Margin="0,0,0,10" ToolTip="@econ.adr.0.tip" Checked="SaveField_Changed" Unchecked="SaveField_Changed"/>
                                        <CheckBox x:Name="ChkAdr1" Uid="econ.adr.1" Content="Класс 2 — Газы" Margin="0,0,0,10" ToolTip="@econ.adr.1.tip" Checked="SaveField_Changed" Unchecked="SaveField_Changed"/>
                                        <CheckBox x:Name="ChkAdr2" Uid="econ.adr.2" Content="Класс 3 — Легковоспламеняющиеся жидкости" Margin="0,0,0,10" ToolTip="@econ.adr.2.tip" Checked="SaveField_Changed" Unchecked="SaveField_Changed"/>
                                        <CheckBox x:Name="ChkAdr3" Uid="econ.adr.3" Content="Класс 4 — Легковоспламеняющиеся твёрдые" Margin="0,0,0,10" ToolTip="@econ.adr.3.tip" Checked="SaveField_Changed" Unchecked="SaveField_Changed"/>
                                        <CheckBox x:Name="ChkAdr4" Uid="econ.adr.4" Content="Класс 6 — Токсичные" Margin="0,0,0,10" ToolTip="@econ.adr.4.tip" Checked="SaveField_Changed" Unchecked="SaveField_Changed"/>
                                        <CheckBox x:Name="ChkAdr5" Uid="econ.adr.5" Content="Класс 8 — Коррозионные" Margin="0,0,0,0" ToolTip="@econ.adr.5.tip" Checked="SaveField_Changed" Unchecked="SaveField_Changed"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" Padding="16,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource SectionIconBadge}" Margin="0,0,8,0">
                                                    <Path Data="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"
                                                          Fill="{DynamicResource AccentBrush}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Uid="econ.skills.title" Text="Навыки водителя" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="⬆ MAX"
                                                    Style="{StaticResource ChipButtonStyle}" Click="BtnMaxSkills_Click"
                                                    ToolTip="@econ.skills.max.tip"/>
                                        </Grid>
                                        <TextBlock Uid="econ.skills.hint" Text="Уровень навыка 0–6"
                                                   FontSize="11" Foreground="#6A7386" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Uid="econ.skill.dist" Text="Дальние дистанции" FontSize="12" VerticalAlignment="Center"
                                                       ToolTip="@econ.skill.dist.tip"/>
                                            <Slider Grid.Column="1" x:Name="SliderSkillDist" Margin="8,0"
                                                    ToolTip="@econ.skill.slider" ValueChanged="SaveField_Changed"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ElementName=SliderSkillDist, Path=Value, StringFormat=F0}"
                                                       FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Uid="econ.skill.fragile" Text="Хрупкие грузы" FontSize="12" VerticalAlignment="Center"
                                                       ToolTip="@econ.skill.fragile.tip"/>
                                            <Slider Grid.Column="1" x:Name="SliderSkillFragile" Margin="8,0"
                                                    ToolTip="@econ.skill.slider" ValueChanged="SaveField_Changed"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ElementName=SliderSkillFragile, Path=Value, StringFormat=F0}"
                                                       FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Uid="econ.skill.urgent" Text="Срочные заказы" FontSize="12" VerticalAlignment="Center"
                                                       ToolTip="@econ.skill.urgent.tip"/>
                                            <Slider Grid.Column="1" x:Name="SliderSkillUrgent" Margin="8,0"
                                                    ToolTip="@econ.skill.slider" ValueChanged="SaveField_Changed"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ElementName=SliderSkillUrgent, Path=Value, StringFormat=F0}"
                                                       FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Uid="econ.skill.eco" Text="Эко-вождение" FontSize="12" VerticalAlignment="Center"
                                                       ToolTip="@econ.skill.eco.tip"/>
                                            <Slider Grid.Column="1" x:Name="SliderSkillEco" Margin="8,0"
                                                    ToolTip="@econ.skill.slider" ValueChanged="SaveField_Changed"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ElementName=SliderSkillEco, Path=Value, StringFormat=F0}"
                                                       FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Uid="econ.skill.valuable" Text="Дорогие грузы" FontSize="12" VerticalAlignment="Center"
                                                       ToolTip="@econ.skill.valuable.tip"/>
                                            <Slider Grid.Column="1" x:Name="SliderSkillValuable" Margin="8,0"
                                                    ToolTip="@econ.skill.slider" ValueChanged="SaveField_Changed"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ElementName=SliderSkillValuable, Path=Value, StringFormat=F0}"
                                                       FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="NoSaveOverlayEconomy" Style="{StaticResource NoSaveOverlayStyle}">
                        <Border Background="#1A1D27" BorderBrush="#2A303C" BorderThickness="1"
                                CornerRadius="14" Padding="32,28" MaxWidth="400"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="24"
                                        Background="{DynamicResource AccentBgBrush}"
                                        HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Path Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H6V4h7v5h5v9z"
                                          Fill="{DynamicResource AccentBrush}"
                                          Width="20" Height="20" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Uid="nosave.title" Text="У вас нет сохранения"
                                           FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock Uid="nosave.hint" Text="Выберите игру, профиль и слот в верхней панели — после этого раздел станет доступен."
                                           FontSize="12.5" Foreground="#7A8496" LineHeight="18"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Margin="0,10,0,20" TextWrapping="Wrap"/>
                                <Button Uid="nosave.cta" Content="Выбрать сохранение"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="40" MinWidth="200" Padding="18,0"
                                        HorizontalAlignment="Center"
                                        Click="BtnPickSave_Click"
                                        ToolTip="@nosave.tip"/>
                            </StackPanel>
                        </Border>
                    </Border>
                    </Grid>
                </TabItem>

                <!-- ╔═══════════════════════════════════════╗ -->
                <!-- ║  TAB 2: MAP & GARAGES                 ║ -->
                <!-- ╚═══════════════════════════════════════╝ -->
                <TabItem Header="Map">
                    <Grid Background="#0F1117">
                    <Grid Margin="22,18,22,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                            <!-- Автодетект модуля карты -->
                            <Border Style="{StaticResource CardStyle}" Margin="0" Padding="16,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource SectionIconBadge}">
                                                <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                                      Fill="{DynamicResource AccentBrush}"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Uid="nav.map" Text="Карта и Гаражи" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtMapDetectSummary" Text="—" FontSize="11" Foreground="#6A7386"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="BtnBrowseMapArchive" Grid.Column="2"
                                                Style="{StaticResource SecondaryButtonStyle}" Height="36"
                                                Click="BtnBrowseMapArchive_Click"
                                                Visibility="Collapsed">
                                            <TextBlock Uid="map.detect.browse" Text="Указать .scs..." FontSize="12"/>
                                        </Button>
                                    </Grid>
                                    <CheckBox x:Name="ChkUnlockMapCities" Margin="0,0,0,8"
                                              Checked="SaveField_Changed" Unchecked="SaveField_Changed">
                                        <TextBlock Uid="map.detect.unlock.cities" Text="Открыть все города карты"
                                                   FontSize="12" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="ChkUnlockMapRoads"
                                              Checked="ChkUnlockMapRoads_Changed" Unchecked="ChkUnlockMapRoads_Changed">
                                        <TextBlock Uid="map.detect.unlock.roads" Text="Открыть туман карты (discovered_items)"
                                                   FontSize="12" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <StackPanel x:Name="PanelMapScanProgress" Visibility="Collapsed" Margin="0,12,0,0">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock x:Name="TxtMapScanProgress" FontSize="11" Foreground="#8A93A5"
                                                       TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="TxtMapScanPercent" FontSize="11" Foreground="#8A93A5"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="BarMapScan" Height="6" Minimum="0" Maximum="100" Value="0"
                                                     Foreground="{DynamicResource AccentBrush}" Background="#0F1117"
                                                     BorderThickness="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="GridMapAdvanced" Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                    <!-- ЛЕВАЯ КОЛОНКА: Города -->
                                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Style="{StaticResource SectionIconBadge}" Margin="0,0,8,0">
                                                        <Path Data="M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5c0 .28.22.5.5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5c0-.28-.22-.5-.5-.5z"
                                                              Fill="{DynamicResource AccentBrush}"
                                                              Width="14" Height="14" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Uid="map.cities.title" Text="Список городов" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                    <Border Background="#12151C" CornerRadius="4" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtCitiesCount" Text="0" FontSize="11" Foreground="#7A8496"/>
                                                    </Border>
                                                </StackPanel>
                                                <Grid Margin="0,4,0,8">
                                                    <TextBox x:Name="TxtSearchCities" ToolTip="@map.cities.search.tip"
                                                             TextChanged="TxtSearchCities_TextChanged" Height="32"
                                                             VerticalContentAlignment="Center"
                                                             BorderBrush="#252932" Background="#141722" Padding="10,0"/>
                                                    <TextBlock Uid="map.cities.search.ph" Text="Поиск города..." IsHitTestVisible="False"
                                                               Foreground="#3A3F50" Margin="12,0,0,0" VerticalAlignment="Center"
                                                               FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearchCities}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <WrapPanel>
                                                    <Button Uid="map.cities.select" Content="Выбрать все" Click="BtnSelectAllCities_Click" FontSize="11"
                                                            Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,4"/>
                                                    <Button Uid="map.cities.clear" Content="Снять все" Click="BtnClearAllCities_Click" FontSize="11"
                                                            Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="10,0" Margin="0,0,0,4"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <Grid>
                                                <ListBox x:Name="ListCities" Background="Transparent" BorderThickness="0"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         HorizontalContentAlignment="Stretch"
                                                         ItemContainerStyle="{StaticResource QuietListBoxItemStyle}"
                                                         ItemTemplate="{DynamicResource CityItemTemplate}"/>
                                                <TextBlock x:Name="TxtCitiesEmpty" Uid="map.cities.empty"
                                                           Text="Загрузите сохранение,&#x0a;чтобы увидеть города"
                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#3A3F50" FontSize="12" LineHeight="18"
                                                           Visibility="Collapsed"/>
                                            </Grid>
                                        </DockPanel>
                                    </Border>

                                    <!-- ПРАВАЯ КОЛОНКА: Гаражи -->
                                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Style="{StaticResource SectionIconBadge}" Margin="0,0,8,0">
                                                        <Path Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-8h8v8zm-2-6h-4v4h4v-4z"
                                                              Fill="{DynamicResource AccentBrush}"
                                                              Width="14" Height="14" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Uid="map.garages.title" Text="Список гаражей" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                    <Border Background="#12151C" CornerRadius="4" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtGaragesCount" Text="0" FontSize="11" Foreground="#7A8496"/>
                                                    </Border>
                                                </StackPanel>
                                                <Grid Margin="0,4,0,8">
                                                    <TextBox x:Name="TxtSearchGarages" ToolTip="@map.garages.search.tip"
                                                             TextChanged="TxtSearchGarages_TextChanged" Height="32"
                                                             VerticalContentAlignment="Center"
                                                             BorderBrush="#252932" Background="#141722" Padding="10,0"/>
                                                    <TextBlock Uid="map.garages.search.ph" Text="Поиск гаража..." IsHitTestVisible="False"
                                                               Foreground="#3A3F50" Margin="12,0,0,0" VerticalAlignment="Center"
                                                               FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearchGarages}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <WrapPanel>
                                                    <Button Uid="map.garages.large" Content="Все → Large" Click="BtnSelectAllGaragesLarge_Click" FontSize="11"
                                                            Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,4"/>
                                                    <Button Uid="map.garages.sell" Content="Распродать все" Click="BtnClearAllGarages_Click" FontSize="11"
                                                            Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="10,0" Margin="0,0,0,4"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <Grid>
                                                <ListBox x:Name="ListGarages" Background="Transparent" BorderThickness="0"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         HorizontalContentAlignment="Stretch"
                                                         ItemContainerStyle="{StaticResource QuietListBoxItemStyle}"
                                                         ItemTemplate="{DynamicResource GarageItemTemplate}"/>
                                                <TextBlock x:Name="TxtGaragesEmpty" Uid="map.garages.empty"
                                                           Text="Загрузите сохранение,&#x0a;чтобы увидеть гаражи"
                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#3A3F50" FontSize="12" LineHeight="18"
                                                           Visibility="Collapsed"/>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                            </Grid>

                    </Grid>
                    <Border x:Name="NoSaveOverlayMap" Style="{StaticResource NoSaveOverlayStyle}">
                        <Border Background="#1A1D27" BorderBrush="#2A303C" BorderThickness="1"
                                CornerRadius="14" Padding="32,28" MaxWidth="400"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="24"
                                        Background="{DynamicResource AccentBgBrush}"
                                        HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Path Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H6V4h7v5h5v9z"
                                          Fill="{DynamicResource AccentBrush}"
                                          Width="20" Height="20" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Uid="nosave.title" Text="У вас нет сохранения"
                                           FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock Uid="nosave.hint" Text="Выберите игру, профиль и слот в верхней панели — после этого раздел станет доступен."
                                           FontSize="12.5" Foreground="#7A8496" LineHeight="18"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Margin="0,10,0,20" TextWrapping="Wrap"/>
                                <Button Uid="nosave.cta" Content="Выбрать сохранение"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="40" MinWidth="200" Padding="18,0"
                                        HorizontalAlignment="Center"
                                        Click="BtnPickSave_Click"
                                        ToolTip="@nosave.tip"/>
                            </StackPanel>
                        </Border>
                    </Border>
                    </Grid>
                </TabItem>

                <!-- ╔═══════════════════════════════════════╗ -->
                <!-- ║  TAB 3: VEHICLE                       ║ -->
                <!-- ╚═══════════════════════════════════════╝ -->
                <TabItem Header="Vehicle">
                    <Grid Background="#0F1117">
                    <Grid Margin="22,18,22,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                            <!-- Trucks: list | repair -->
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.15*"/>
                              </Grid.ColumnDefinitions>

                              <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                                <DockPanel LastChildFill="True">
                                  <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                      <Border Style="{StaticResource SectionIconBadge}" Margin="0,0,8,0">
                                        <Path Data="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-3.5 3.5h-2.5V8.5H18v3z"
                                              Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      </Border>
                                      <TextBlock Uid="veh.list.trucks" Text="Грузовики"
                                                 FontSize="14" FontWeight="SemiBold" Foreground="#E8ECF4" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#12151C" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                      <TextBlock x:Name="TxtTrucksCount" Text="0" FontSize="11" Foreground="#7A8496"/>
                                    </Border>
                                  </Grid>
